# Manta runtime state — ephemeral, not source
.manta/clones/
last-gasp-report.md
.manta/locks/
.manta/state/
.manta/reports/
.manta/audit/
.manta/sandbox/
.manta/graveyard/
.manta/snapshots/
.manta/worktrees/
.manta/active.json
.manta/config/
.manta/heartbeat-touch.cjs

# Graphify runtime artifacts (regenerable, not source)
graphify-out/

# Local Claude Code settings (not source)
.claude/

# Serena MCP local state (not source)
.serena/

# Node / build
node_modules/
dist/
build/
*.log
.turbo/

# Claude Code plugin payload — committed distributable.
# Plugins install by git clone into the plugin cache with NO build step, so the
# bundle must be tracked. `pnpm build:plugin` assembles exactly these two files
# from packages/manta-cli/dist; everything else under dist/ stays ignored.
!/dist/
!/dist/bin/
!/dist/bin/manta.cjs
!/dist/bin/server.cjs

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# OS — macOS Finder artifacts (defensive: also ignored anywhere nested)
.DS_Store
**/.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
.cursor/

# Secrets
.env
.env.local
.env.*.local
credentials.json
*.pem
*.key

# Tests / coverage
coverage/
.nyc_output/
.pytest_cache/

# Test artifacts
junit.xml

# TypeScript build artifacts
*.tsbuildinfo
packages/*/dist/
# Plugin bundle intermediate (tsup.plugin.config.ts output; copied to /dist/bin by build:plugin)
packages/*/plugin-dist/
.tsbuild/
pnpm-debug.log*
last-gasp-report.md
