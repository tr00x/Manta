{
  "description": "Manta hooks (convention-discovered at the plugin root). SessionStart priming injects the orchestration contract once per session; UserPromptSubmit routing injects the manta-orchestrate skill on any Manta-intent prompt so the console is in context the moment the user reaches for Manta — not left to soft skill-listing chance.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/bin/manta-session-priming.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/bin/manta-prompt-router.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__manta-bus__manta_cast|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/bin/manta-skill-gate.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/bin/manta-skill-mark.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
