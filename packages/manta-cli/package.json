{
  "name": "manta",
  "version": "0.1.0",
  "description": "Manta CLI — cast, status, kill, abort, recover (Phase 0 recon-swarm)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tr00x/Manta.git"
  },
  "homepage": "https://github.com/tr00x/Manta#readme",
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "self-cloning",
    "parallel-agents",
    "mcp",
    "orchestration"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "manta": "./dist/bin/manta.js",
    "manta-bus": "./dist/bin/server.cjs",
    "manta-validate-skills": "./dist/bin/manta-validate-skills.js"
  },
  "files": [
    "dist/bin",
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "execa": "^8.0.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.0.0",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.6.3",
    "tar": "^7.4.3",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
